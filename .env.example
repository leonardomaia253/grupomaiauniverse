# Application
NEXT_PUBLIC_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_HIMETRICA_API_KEY=
NEXT_PUBLIC_MAIA_STORY_INTRO=true

# Supabase server access (never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application security
ADMIN_EMAILS=admin@example.com
ADMIN_PROXY_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters
UNSUBSCRIBE_HMAC_SECRET=replace-with-at-least-32-random-characters

# Distributed rate limiting (required in production)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# GitHub
GITHUB_TOKEN=github_pat_your-token

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Resend
RESEND_API_KEY=re_your-resend-key
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret

# Optional alternative payment providers
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true

# Operational controls
# Set only for build environments that intentionally cannot access secrets.
SKIP_ENV_VALIDATION=false
HEALTHCHECK_TOKEN=replace-with-at-least-32-random-characters
